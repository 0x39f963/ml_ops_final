# Synthetic stub policy:
# data/sample_synth.parquet is allowed in git because it is synthetic.
# Every other parquet under data/ is local-only and ignored.
data/*.parquet
data/**/*.parquet
data/feature_store/
data/feature_store_real/
data/feature_store_real
!data/sample_synth.parquet

# MDD latency datasets are synthetic but large; notebooks regenerate them locally.
data/*latency*.csv

# Local model artifacts are not committed.
models/*
models_real/
models_real
!models/.gitkeep
*.pkl
*.joblib
mlruns/
mlruns_real/
mlruns_real
mlflow/
mlflow.db
*.db-journal

# Local secrets and runtime config.
.env

# Python cache and test cache.
__pycache__/
*/__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Terraform artifacts for future infra work.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
tfplan
tfdestroy
*.tfplan
crash.log
crash.*.log
.infra_artifacts/

# Airflow and runtime logs for future DAG work.
airflow_home/
logs/

# Monitoring runtime outputs.
reports/*.html
reports/*_real.*
reports/prometheus/*.prom

# Local-only helper scripts and scratch files.
.local/
