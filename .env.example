# Generated at: 2026-05-31 20:37:33 MSK
#
# Copy this file to .env and fill local-only values.
# Do not commit real paths, secrets, real data, or model artifacts.

DATA_DIR=/local/path/to/real/parquet/dir   # local-only, gitignored
EVENTS_PARQUET=${DATA_DIR}/enriched_event_table.parquet   # real events, local-only
SEGMENT_TIMELINE_PARQUET=${DATA_DIR}/segment_timeline.parquet   # real timeline, local-only
SCORING_REGISTRY_PARQUET=${DATA_DIR}/scoring_registry.parquet   # real registry, local-only
FEATURE_STORE_DIR=data/feature_store   # local parquet feature store, gitignored
MODEL_DIR=./models   # local-only, gitignored
MIN_SUPPORT=50   # product positive support threshold in train
TRAIN_SEED=42   # deterministic training seed
TOP_N=10   # default recommendation list length
API_PORT=18000   # host port for FastAPI; container listens on 8000
DATA_CUTOFF=   # optional YYYYQn; empty means champion metadata or latest completed quarter
SCORE_DECISION_THRESHOLD=0.5   # recommend when p >= threshold
MODEL_REFRESH_ON_REQUEST=false   # reload champion alias before each score request when true
MLFLOW_PORT=15000   # host port for MLflow UI/API; compose service listens on 5000
MLFLOW_TRACKING_URI=http://localhost:${MLFLOW_PORT:-15000}   # host client URI; inside compose use http://mlflow:5000
MLFLOW_MODEL_NAME=nbo_topn   # registered model name
MLFLOW_BACKEND_STORE_URI=sqlite:////mlflow/mlflow.db   # inside mlflow container
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts   # inside mlflow container
